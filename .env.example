NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only. Do not use a NEXT_PUBLIC_ prefix for this key.
GEMINI_API_KEY=
# Use a Google AI Studio project on the Free Tier with no billing account linked.
# New projects: gemini-3.5-flash-lite (default, supports recipe images and text).
# Legacy projects only: gemini-2.5-flash, gemini-2.5-flash-lite.
GEMINI_RECIPE_MODEL=gemini-3.5-flash-lite
